{
  "name": "@femida/types",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@femida/eslint-config": "workspace:*",
    "@femida/tsconfig": "workspace:*",
    "eslint": "9.13.0",
    "rimraf": "6.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
