{
  "name": "femida",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:migrate": "pnpm --filter @femida/api run db:migrate",
    "db:push": "pnpm --filter @femida/api run db:push",
    "db:seed": "pnpm --filter @femida/api run db:seed",
    "db:generate": "pnpm --filter @femida/api run db:generate",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.4",
      "body-parser": "1.20.6",
      "brace-expansion@^1.1.7": "1.1.18",
      "brace-expansion@^2.0.1": "2.1.4",
      "fast-xml-parser": "5.7.0",
      "file-type": "21.3.2",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "nanoid": "3.3.17",
      "postcss": "8.5.26",
      "qs": "6.15.3",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  }
}
